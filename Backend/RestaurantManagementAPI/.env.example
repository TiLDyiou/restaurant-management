# ==============================================================================
# RESTAURANT MANAGEMENT SYSTEM (QLNH) ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and populate with production values.
# DO NOT COMMIT THE REAL '.env' FILE TO VERSION CONTROL.

# ------------------------------------------------------------------------------
# 1. DATABASE & REDIS INFRASTRUCTURE CONFIGURATION
# ------------------------------------------------------------------------------
# SQL Server connection string for Docker orchestration
# Default container name is 'sqlserver', port 1433
ConnectionStrings__QLNHDatabase=Server=sqlserver,1433;Database=QLNHDatabase;User Id=sa;Password=YourSecurePassword123!;Encrypt=True;TrustServerCertificate=True;

# Redis connection string for load-balancing SignalR backplane and Response Caching
# Default container name is 'redis', port 6379
ConnectionStrings__Redis=redis:6379

# ------------------------------------------------------------------------------
# 2. JWT SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# JWT signing key (Min 256 bits, must be a long cryptographically secure string)
Jwt__Key=YourSuperSecretAndSecureKeyThatIsAtLeast32BytesLong!

# Issuer & Audience details matching the production domain
Jwt__Issuer=QLNH_API
Jwt__Audience=QLNH_Clients

# ------------------------------------------------------------------------------
# 3. SMTP EMAIL SETTINGS
# ------------------------------------------------------------------------------
# Email credentials used for OTP (One-Time Password) generation
EmailSettings__SenderEmail=nguyentrangiabao7100@gmail.com
EmailSettings__SenderName=Nhà hàng ẩm thực nhóm II
EmailSettings__AppPassword=qavaidpcazalzofv
EmailSettings__Host=smtp.gmail.com
EmailSettings__Port=587

# ------------------------------------------------------------------------------
# 4. SYSTEM PORTS & ENVIRONMENT CONTROLS
# ------------------------------------------------------------------------------
# API Hosting ports in containers
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_ENVIRONMENT=Production

# SQL Server Container SA Password (must match the database connection string)
MSSQL_SA_PASSWORD=YourSecurePassword123!
ACCEPT_EULA=Y
